# ==========================================
# FinSight Environment Variables Example
# ==========================================
# Copy this file to '.env' in your root directory, or
# create separate .env files in frontend/ and backend/
#
# NOTE: DO NOT commit your actual .env file to GitHub!

# ------------------------------------------
# Backend Settings (FastAPI)
# ------------------------------------------

# Your Groq API key for LLM features.
# Get one at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here

# The port your backend runs on (Defaults to 8000)
# Note: Render automatically provides this variable in production.
PORT=8000

# ------------------------------------------
# Frontend Settings (React/Vite)
# ------------------------------------------

# URL pointing to your backend API.
# For local development, it is usually http://localhost:8000
# Note: Render automatically links this via 'fromService' in render.yaml!
VITE_API_URL=http://localhost:8000
